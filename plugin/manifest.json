{
  "id": "com.captionguard.cn",
  "name": "CaptionGuard CN",
  "version": "0.2.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": ["http://127.0.0.1:8765"]
    }
  },
  "entrypoints": [
    {
      "id": "captionguardPanel",
      "type": "panel",
      "label": { "default": "CaptionGuard CN" },
      "minimumSize": { "width": 300, "height": 420 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 420, "height": 720 }
    }
  ]
}
